# OS & software specific files
.Rproj.user
.Rhistory
.DS_Store
Icon?

# create git-include/git-exclude subdirectory to force include/exclude file
# e.g. if data/ is specified in this .gitignore file,
# data/git-include/ will still be included in the commit,
# but the rest of the data/ will be ignored
!git-include/
git-exclude/

resources/
# scripts/
scratch/

# Ignore the contents of these directories but keep their README.md stubs tracked
# (NOTE: use "dir/*" + "!dir/README.md", not "dir/" + "!dir/README.md" — git will not
# descend into a directory that's ignored outright, so a bare "dir/" makes any
# negation of a file inside it a no-op)
admin/*
!admin/README.md
job_logs/*
!job_logs/README.md
results/*
!results/README.md
figures/*
!figures/README.md
tables/*
!tables/README.md
writing/*
!writing/README.md

# uncomment the following to ignore specific folder / files

# admin/
# results/
# *.tsv
# *.csv
# writing/
